      RememberJoins = true
   },
   KeySystem = false, -- ไม่ใช้ระบบคีย์ เพื่อความสะดวกในการใช้งาน
   KeySettings = {
      Title = "Key System",
      Subtitle = "Bypass",
      Note = "No key required",
      FileName = "Key",
      SaveKey = true,
      GrabKeyFromSite = false,
